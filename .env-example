# === Docker (docker-compose.yml) ===

# Your EDB account token: https://www.enterprisedb.com/repos/getting_started/get_your_token/
# Used at build time only, to install aidb/pgfs from EDB's package repo onto
# the base image below (see postgres/Dockerfile) — never baked into the image.
EDB_SUBSCRIPTION_TOKEN=

# Base image for the postgres service (bare Postgres 18, no aidb/pgfs yet —
# postgres/Dockerfile adds those). Pull it once with your own token first:
#   docker login docker.enterprisedb.com --username k8s --password "$EDB_SUBSCRIPTION_TOKEN"
PG_BASE_IMAGE=docker.enterprisedb.com/k8s/postgresql:18.6-standard-ubi9

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# === Model (used by the webapp container) ===
# Free key: https://build.nvidia.com/explore/discover — sign in, open any
# model card, copy the key from its "Get API Key" panel.
NVIDIA_API_KEY=nvapi-xxxxxx

# Optional: override if NVIDIA retires the current defaults (see README's
# "A note on NVIDIA NIM model churn"). Leave unset to use create_pipelines.py's
# built-in defaults.
# NIM_EMBEDDINGS_MODEL=nvidia/nemotron-3-embed-1b
# NIM_COMPLETIONS_MODEL=nvidia/nemotron-3-super-120b-a12b

# === Non-Docker / manual path only ===
# If you're running app.py / the Streamlit chat directly against your own
# Postgres instance instead of via docker-compose, set these yourself:
# DATABASE_URL=postgres://user:password@host:5432/demo?sslmode=require
# BOOTSTRAP_DB=postgres
# CATALOGS_BUCKET_URI=s3://your-bucket
# S3_REGION=us-east-1
# S3_ENDPOINT=              # e.g. http://localhost:9000 for MinIO; leave unset for AWS S3
# S3_ALLOW_HTTP=false
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
